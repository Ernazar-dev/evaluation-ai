# ============================================================
#  Backend environment TEMPLATE
#  Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
#  Bu fayl commit qilinadi — bu yerga HAQIQIY parol/kalit yozmang!
# ============================================================

# PostgreSQL: postgresql://<user>:<PAROL>@<host>:<port>/<baza>?schema=public
# Ikkinchi qism (":" dan keyingi) — parol turadigan joy.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ai_assistant?schema=public"
# Neon (yoki boshqa bulutli Postgres) uchun: "direct" satrni oling — hostida
# "-pooler" bo'lgani emas, chunki `prisma db push` pgbouncer orqali o'tmaydi.
# Uchta parametr shart:
#   sslmode=require    — Neon shifrlanmagan ulanishni umuman qabul qilmaydi
#   connect_timeout=20 — bepul Neon 5 daqiqa bo'shdan keyin uxlaydi; Prisma'ning
#                        standart 5 soniyasi uyg'onishga yetmay "Can't reach
#                        database server" beradi
#   connection_limit=5 — aks holda Prisma pool hajmini host CPU soniga qarab
#                        oladi, bu esa Neon limitini bekorga yeydi
# DATABASE_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=20&connection_limit=5"

# JWT imzolash kaliti — uzun tasodifiy satr:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# --- Boshlang'ich admin hisobi ------------------------------
# seed/reset FAQAT shu bitta hisobni yaratadi. Qolgan hamma foydalanuvchini
# admin ilova ichidan qo'shadi va login/parolini beradi. Jonli ishga
# tushirishdan oldin ALBATTA o'zgartiring va maxfiy saqlang.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_FULL_NAME="Administrator"

PORT=5000
NODE_ENV=development

# CORS: ruxsat berilgan frontend manzillari (vergul bilan, yoki *)
CORS_ORIGINS="http://localhost:5173"

# --- AI baholash: Gemini (ASOSIY grader) ---------------------
# Kalit: https://aistudio.google.com/apikey
# Bo'sh bo'lsa -> OpenRouter -> mock grader (soxta, matn uzunligi bo'yicha ball).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
# Kvota har bir model uchun alohida hisoblanadi. Asosiy model 429 (limit)
# qaytarganda baholash to'xtab qolmasligi uchun zaxira zanjiri kerak — oxirida
# eskiroq, kam band model tursin.
GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash"
# Bitta ish uchun nechta mustaqil baho olib o'rtachalash (1..5).
# DIQQAT: har bir sample = 1 ta API so'rovi, GEMINI_VERIFY=true yana bittasini
# qo'shadi. Ya'ni SAMPLES=3 + VERIFY=true => bitta ish uchun 4 ta so'rov.
# Bepul kalitda kunlik limit tez tugaydi va baholash "mock"ka tushib qoladi —
# bepul kalit uchun SAMPLES=1 qo'ying, 3 ni faqat pullik kalitda ishlating.
GEMINI_SAMPLES=1
GEMINI_VERIFY=false
GEMINI_TIMEOUT_MS=120000

# --- AI baholash: OpenRouter (zaxira, ixtiyoriy) -------------
OPENROUTER_API_KEY=""
SITE_URL="http://localhost:5000"
SITE_NAME="Independent Work Evaluation-AI"

# --- Fan bilim bazasi (knowledge base) ----------------------
# KB_DIR papkasidagi darslik/qollanmalar (.pdf/.docx/.pptx/.txt/.md) va fanga
# yuklangan kitoblardan AI javoblarni tekshiradi. Kop kitob = kop aniqlik.
KB_ENABLED=true
KB_DIR="../data-fayl"
KB_MAX_CHARS=24000

# Yuklangan fayllar papkasi
UPLOADS_DIR="./uploads"
